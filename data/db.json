      "id": "SPEC-01",
      "commonName": "Water Hyacinth",
      "scientificName": "Eichhornia crassipes",
      "risk": "Critical",
      "habitat": "Freshwater lakes, rivers, dams, irrigation reservoirs",
      "spreadPathway": "Water currents, boats, fishing gear, decorative trade",
      "status": "Established",
      "lastObserved": "2026-10-26",
      "impactSummary": "Forms dense impenetrable mats blocking sunlight, depleting oxygen for fish, choking water intake pumps, and harboring disease vectors.",
      "controlMethods": {
        "mechanical": "Harvester boats, floating physical booms, manual winch extraction before flowering.",
        "chemical": "Glyphosate (aquatic formulation 2.5 L/ha) or 2,4-D amine with non-ionic surfactant. Strictly avoid open potable water sources.",
        "biological": "Weevils Neochetina eichhorniae and Neochetina bruchi.",
        "restoration": "Replant native reeds (Typha capensis, Cyperus papyrus) along banks."
      }
    },
