      "id": "SPEC-02",
      "commonName": "Prosopis (Mathenge / Mesquite)",
      "scientificName": "Prosopis juliflora",
      "risk": "High",
      "habitat": "Arid, semi-arid rangelands, riverbanks, irrigated canals",
      "spreadPathway": "Livestock ingestion, flash floods, seed pods in feed",
      "status": "Expanding",
      "lastObserved": "2026-10-25",
      "impactSummary": "Deep taproots deplete groundwater table, aggressive thorns injure livestock, displaces native Acacia, forms monoculture thickets.",
      "controlMethods": {
        "mechanical": "Root-collar excavation 10-15 cm below soil level; stump extraction.",
        "chemical": "Basal bark spray with Triclopyr (1.5-2%) in diesel carrier applied immediately to cut stumps.",
        "biological": "Seed-feeding bruchid beetles (Algarobius prosopis).",
        "restoration": "Reseed with drought-hardy native grasses (Cenchrus ciliaris, Eragrostis)."
      }
    },
    {
      "id": "SPEC-03",
      "commonName": "Lantana",
      "scientificName": "Lantana camara",
      "risk": "High",
      "habitat": "Forest margins, pastures, fallow arable plots, roadsides",
      "spreadPathway": "Frugivorous birds, ornamental trade, soil disturbance",
      "status": "Established",
      "lastObserved": "2026-10-24",
      "impactSummary": "Allelopathic toxins suppress crop seedling germination, poisonous to cattle, forms impenetrable barriers that impede farm equipment.",
      "controlMethods": {
        "mechanical": "Bulldozer blade grubbing, hand pulling of taproot when soil is moist.",
        "chemical": "Foliar spray Fluroxypyr or Glyphosate (1.5% v/v) during active vegetative growth.",
        "biological": "Lantana bug (Teleonemia scrupulosa), leaf-mining beetle (Octotoma scabripennis).",
        "restoration": "Immediate establishment of competitive legume cover crops (Desmodium, Mucuna)."
      }
    },
    {
      "id": "SPEC-04",
      "commonName": "Giant Salvinia (Kariba Weed)",
      "scientificName": "Salvinia molesta",
      "risk": "Critical",
      "habitat": "Slow-moving rivers, swamps, irrigation canals, aquaculture ponds",
      "spreadPathway": "Contaminated machinery, waterfowl, water sport equipment",
      "status": "Emerging",
      "lastObserved": "2026-10-21",
      "impactSummary": "Doubles biomass in 3-5 days under warm conditions; suffocates aquatic life and clogs drainage networks.",
      "controlMethods": {
        "mechanical": "Surface skimming with specialized nylon nets; containment booms.",
        "chemical": "Endothall or Diquat Dibromide aquatic formulation (licensed handlers only).",
        "biological": "Cyrtobagous salviniae weevils (highly host-specific and effective).",
        "restoration": "Monitor water flow velocity and aerate holding basins."
      }
    },
    {
      "id": "SPEC-05",
      "commonName": "Parthenium Weed (Congress Grass)",
      "scientificName": "Parthenium hysterophorus",
      "risk": "High",
      "habitat": "Agricultural fields, roadsides, disturbed land, overgrazed pastures",
      "spreadPathway": "Vehicles, contaminated seed grain, livestock hooves",
